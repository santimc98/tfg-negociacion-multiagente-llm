%% Logica del agente juez / mediador (RuleBasedMediator)
%%{init: {"flowchart": {"rankSpacing": 35, "nodeSpacing": 40}}}%%
flowchart TD
    IN(["Mediador invocado"]) --> LOOP["Para cada variable negociada:<br/>precio, cantidad y plazo"]
    LOOP --> C{"¿Existe solape entre los limites<br/>de aceptacion de ambas partes?"}
    C -->|"No"| IMP["Declara IMPASSE<br/>(no existe zona de acuerdo)"]
    C -->|"Si"| MID["Toma un punto equilibrado del solape,<br/>recortado a los rangos publicos"]
    MID --> CHK{"¿El compromiso cumple las restricciones<br/>publicas y ambos guardrails privados?"}
    CHK -->|"No"| IMP
    CHK -->|"Si"| OUT["Tabula el compromiso<br/>(la contraparte puede aceptarlo)"]

    classDef ok fill:#14402c,stroke:#2faf6a,color:#d8f7e6;
    classDef no fill:#44181c,stroke:#d65151,color:#ffdede;
    class OUT ok;
    class IMP no;
