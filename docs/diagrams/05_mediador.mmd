%% Logica del agente juez / mediador (RuleBasedMediator)
flowchart LR
    IN(["Mediador invocado"]) --> P["Calcula solape de PRECIO:<br/>min. vendedor .. max. comprador"]
    P --> PC{"min. vendedor<br/>&lt;= max. comprador?"}
    PC -->|No| IMP
    PC -->|Si| Q["Calcula CANTIDAD:<br/>max(min. comprador, min. vendedor)"]
    Q --> QC{"&lt;= cantidad maxima<br/>publica?"}
    QC -->|No| IMP
    QC -->|Si| D["Calcula solape de PLAZO:<br/>mas temprano vendedor .. mas tardio comprador"]
    D --> DC{"vendedor<br/>&lt;= comprador?"}
    DC -->|No| IMP
    DC -->|Si| MID["Punto equilibrado dentro de cada solape<br/>(recortado a los rangos publicos)"]
    MID --> CHK{"Cumple restricciones publicas<br/>y ambos guardrails privados?"}
    CHK -->|No| IMP
    CHK -->|Si| OUT["Tabula compromiso<br/>(la contraparte puede ACCEPT)"]
    IMP["Declara IMPASSE<br/>(no existe zona de acuerdo)"]

    classDef ok fill:#14402c,stroke:#2faf6a,color:#d8f7e6;
    classDef no fill:#44181c,stroke:#d65151,color:#ffdede;
    class OUT ok;
    class IMP no;
